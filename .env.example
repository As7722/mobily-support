# ============================================================
# Mobily Tech Support System — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
APP_NAME="Mobily Tech Support System"
APP_VERSION="4.1.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # false in production
BASE_URL=http://localhost:8000

# Random 64-char hex string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key_at_least_32_chars

# Comma-separated list of allowed CORS origins (leave empty to allow all in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─────────────────────────────────────────────
# Database (PostgreSQL 16.4)
# ─────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mobily_support
POSTGRES_USER=mobily
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Connection pool tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ─────────────────────────────────────────────
# Redis 7.2
# ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_DB=0

# Cache TTLs (seconds)
REDIS_TTL_SESSION=86400
REDIS_TTL_PERMISSIONS=900
REDIS_TTL_KPI_CACHE=300
REDIS_TTL_RATE_LIMIT=60

# ─────────────────────────────────────────────
# Celery
# ─────────────────────────────────────────────
# Leave empty — auto-computed from REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ─────────────────────────────────────────────
# JWT Authentication (RS256 — Asymmetric)
# ─────────────────────────────────────────────
# Generate keys:
#   openssl genrsa -out private_key.pem 4096
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
# Then paste the full PEM content (with \n preserved) here.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_FULL_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_FULL_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_IDLE_TIMEOUT_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2id hashing parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ─────────────────────────────────────────────
# Field Encryption (AES-256 for integration_configs)
# ─────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_fernet_key

# ─────────────────────────────────────────────
# File Storage (S3-compatible)
# Supported: Backblaze B2, MinIO, AWS S3
# ─────────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET_NAME=mobily-support
S3_REGION=us-east-1
S3_SIGNED_URL_EXPIRY=3600

# ─────────────────────────────────────────────
# Email — Outbound SMTP
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@mobily.com.sa
SMTP_PASSWORD=your_smtp_app_password
SMTP_TLS=true
SMTP_FROM_EMAIL=support@mobily.com.sa
SMTP_FROM_NAME="Mobily Support"

# ─────────────────────────────────────────────
# Email — Inbound IMAP (ticket creation from email)
# ─────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=support@mobily.com.sa
IMAP_PASSWORD=your_imap_app_password
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_SECONDS=60

# ─────────────────────────────────────────────
# Twilio (SMS + WhatsApp)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=+966500000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─────────────────────────────────────────────
# ClamAV (Virus Scanner)
# ─────────────────────────────────────────────
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMAV_ENABLED=true

# ─────────────────────────────────────────────
# Sentry (Error Monitoring)
# ─────────────────────────────────────────────
SENTRY_DSN=https://your_key@sentry.io/your_project_id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────
# Internationalisation
# ─────────────────────────────────────────────
DEFAULT_LANGUAGE=ar
TIMEZONE=Asia/Riyadh

# ─────────────────────────────────────────────
# SLA Business Hours (Arabia/Riyadh)
# ─────────────────────────────────────────────
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=16
# Days: 6=Sunday, 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday
BUSINESS_DAYS=[6,0,1,2,3]

# ─────────────────────────────────────────────
# Flower (Celery Task Monitor)
# ─────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_flower_password

# ─────────────────────────────────────────────
# CSAT
# ─────────────────────────────────────────────
CSAT_TOKEN_EXPIRY_DAYS=7
